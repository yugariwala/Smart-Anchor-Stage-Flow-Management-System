{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cuepilot-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",

  // Public, non-secret configuration. GEMINI_API_KEY is a Worker SECRET and is set with
  //   npx wrangler secret put GEMINI_API_KEY
  // It must never appear here or anywhere else in the working tree.
  "vars": {
    "FIREBASE_PROJECT_ID": "smart-anchor-stage-flow-system",
    "ALLOWED_ORIGINS": "http://localhost:5173",
    "GEMINI_MODEL": "gemini-3.5-flash-lite",
    "AI_ENABLED": "false",
    "VOICE_REMINDERS_ENABLED": "false",
    "APP_ENV": "dev",
    "BUILD_COMMIT": "dev"
  },

  "env": {
    "production": {
      "vars": {
        "FIREBASE_PROJECT_ID": "smart-anchor-stage-flow-system",
        "ALLOWED_ORIGINS": "https://smart-anchor-stage-flow-system.web.app,https://smart-anchor-stage-flow-system.firebaseapp.com",
        "GEMINI_MODEL": "gemini-3.5-flash-lite",
        "AI_ENABLED": "true",
        "VOICE_REMINDERS_ENABLED": "false",
        "APP_ENV": "production",
        "BUILD_COMMIT": "7a1457a"
      },
      "durable_objects": {
        "bindings": [
          { "name": "EVENT_ROOMS", "class_name": "EventRoom" },
          { "name": "QUOTA_ROOMS", "class_name": "QuotaRoom" }
        ]
      }
    }
  },

  "durable_objects": {
    "bindings": [
      { "name": "EVENT_ROOMS", "class_name": "EventRoom" },
      { "name": "QUOTA_ROOMS", "class_name": "QuotaRoom" }
    ]
  },

  // Both classes are registered as NEW SQLITE classes.
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["EventRoom", "QuotaRoom"]
    }
  ],

  "observability": { "enabled": true }
}
