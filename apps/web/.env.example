# Firebase WEB configuration. This is public client config, not a server secret — it ships
# in the browser bundle. The Gemini key is a Worker secret and never appears here.
VITE_API_BASE_URL=http://127.0.0.1:8787/v1
VITE_FIREBASE_API_KEY=your-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=your-app-id
